   "source": [
    "import matplotlib.pyplot as plt\n",
    "import pandas as pd\n",
    "\n",
    "data = pd.DataFrame({\n",
    "    \"Month\": [\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\"],\n",
    "    \"Revenue\": [120, 150, 135, 180, 220]\n",
    "})\n",
    "\n",
    "display(data)\n",
    "\n",
    "data.plot(x=\"Month\", y=\"Revenue\", marker=\"o\")\n",
    "plt.title(\"Monthly Revenue\")\n",
    "plt.show()"
   ]
  }
